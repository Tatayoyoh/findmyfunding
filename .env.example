DATABASE_PATH=data/findmyfundings.db
SCRAPE_INTERVAL_DAYS=30

# DeepSeek — LLM extraction (scraper) + Excel date parsing, via OpenAI-compatible API
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Traefik (production)
TRAEFIK_DOMAIN=findmyfunding.rgdp.space
TRAEFIK_TLS=true
TRAEFIK_ENTRYPOINTS=https
TRAEFIK_CERTRESOLVER=letsencrypt
