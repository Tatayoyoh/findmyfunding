DATABASE_PATH=data/findmyfundings.db
SCRAPE_INTERVAL_DAYS=30

# Firecrawl self-host (URL côté app)
# - Docker prod (compose): firecrawl-api:3002 (DNS interne)
# - Dev local (uvicorn host): http://localhost:3002 (port expose via FIRECRAWL_HOST_PORT)
FIRECRAWL_API_URL=http://firecrawl-api:3002
FIRECRAWL_API_KEY=
FIRECRAWL_HOST_PORT=3002

# DeepSeek pour LLM extract via API OpenAI-compatible (consommé par firecrawl-api)
DEEPSEEK_API_KEY=sk-...
MODEL_NAME=deepseek-chat

# Postgres interne Firecrawl (laisser par défaut sauf besoin)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Firecrawl tuning (optionnel)
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3

# Traefik (production)
TRAEFIK_DOMAIN=findmyfunding.rgdp.space
TRAEFIK_TLS=true
TRAEFIK_ENTRYPOINTS=https
TRAEFIK_CERTRESOLVER=letsencrypt