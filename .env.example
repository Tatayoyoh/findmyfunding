DATABASE_PATH=data/findmyfundings.db
SCRAPE_INTERVAL_DAYS=30

# Turso (libSQL) — remote durable DB. Set both in production (FastAPI Cloud has
# ephemeral storage + multiple replicas, so a local SQLite file is not shared
# nor persisted). Leave empty to use the local file at DATABASE_PATH (dev).
# Create a DB + token: https://docs.turso.tech/quickstart
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# DeepSeek — LLM extraction (scraper) + Excel date parsing, via OpenAI-compatible API
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# Traefik (production)
TRAEFIK_DOMAIN=findmyfunding.rgdp.space
TRAEFIK_TLS=true
TRAEFIK_ENTRYPOINTS=https
TRAEFIK_CERTRESOLVER=letsencrypt
